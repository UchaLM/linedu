{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://linedu-api.onrender.com/api",
        "EXPO_PUBLIC_AUTH_URL": "https://linedu-api.onrender.com"
      }
    },
    "production": {
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://linedu-api.onrender.com/api",
        "EXPO_PUBLIC_AUTH_URL": "https://linedu-api.onrender.com"
      }
    }
  }
}
