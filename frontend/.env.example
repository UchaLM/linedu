# Google OAuth Client IDs (Google Cloud Console -> APIs & Services -> Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# URL del backend. En desarrollo con el celular: http://IP-DE-TU-PC:3000/api  ·  En producción: la de Render
EXPO_PUBLIC_API_URL=
# URL pública https del backend (login con Google en celular)
EXPO_PUBLIC_AUTH_URL=
