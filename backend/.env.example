PORT=3000
# Secret to sign login tokens (use a long random string)
JWT_SECRET=
# AI assistant: set ONE of these keys
GEMINI_API_KEY=       # https://aistudio.google.com/apikey  (model: gemini-2.5-flash, override with GEMINI_MODEL)
ANTHROPIC_API_KEY=    # https://console.anthropic.com       (override model with ANTHROPIC_MODEL)

# Google OAuth para Expo Go / celular (flujo mediado por el backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=           # https público del backend, ej. https://abc123.lhr.life

# Neon (PostgreSQL). `neon deploy` completa estas dos variables en .env
DATABASE_URL=
DATABASE_URL_UNPOOLED=
